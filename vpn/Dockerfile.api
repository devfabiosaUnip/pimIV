FROM mcr.microsoft.com/dotnet/sdk:10.0 AS build
WORKDIR /src
COPY Manutencao.sln ./
COPY src/ ./src/
RUN dotnet restore src/Manutencao.Api/Manutencao.Api.csproj
RUN dotnet publish src/Manutencao.Api/Manutencao.Api.csproj -c Release -o /app/publish

FROM mcr.microsoft.com/dotnet/aspnet:10.0
WORKDIR /app
COPY --from=build /app/publish .
EXPOSE 8080
ENTRYPOINT ["dotnet", "Manutencao.Api.dll"]
